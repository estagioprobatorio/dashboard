# =========================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS TiDB CLOUD (Serverless MySQL)
# =========================================================================
# Obtenha os dados no TiDB Cloud Console (https://tidbcloud.com) -> Connect
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=seu_usuario.root
TIDB_PASSWORD=sua_senha_aqui
TIDB_DATABASE=test

# Ou string de conexão única MySQL:
TIDB_DATABASE_URL=mysql://seu_usuario.root:sua_senha@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test?ssl={"rejectUnauthorized":true}

# =========================================================================
# DUAL-SYNC COM GOOGLE APPS SCRIPT / GOOGLE DRIVE (Opcional)
# =========================================================================
VITE_APPS_SCRIPT_URL=
